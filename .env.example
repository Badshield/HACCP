# =====================================================================
#  Configuration de Pack Hygiène HACCP
#  Copiez ce fichier en « .env » (deploy/install.sh le fait pour vous),
#  puis vérifiez avec : npm run check-config
#  ⚠ Ne publiez jamais le fichier .env : il contient vos secrets.
# =====================================================================

# ---------- Essentiel ----------
# Nom de domaine de l'application (sans https://), utilisé par Caddy pour le certificat HTTPS
DOMAIN=
# E-mail pour les avis Let's Encrypt (expiration de certificat)
ACME_EMAIL=
# Adresse publique complète (liens des e-mails, retours de paiement)
APP_URL=https://app.mon-domaine.fr
# Secret de signature des sessions : OBLIGATOIRE, 32 caractères minimum (openssl rand -hex 32)
JWT_SECRET=
# Nom affiché dans l'application et les e-mails
APP_NAME=Pack Hygiène HACCP

# ---------- Développement local uniquement (Docker Compose fixe ces valeurs en production) ----------
PORT=3000
DB_FILE=./data/haccp.db
UPLOAD_DIR=./data/uploads
# Mettre à 1 derrière un reverse proxy (déjà fait par docker-compose.yml)
TRUST_PROXY=
# Fuseau horaire d'affichage dans les PDF
TZ_DISPLAY=Europe/Paris

# ---------- Facturation Stripe (vide = facturation désactivée, ACCÈS ILLIMITÉ) — docs/STRIPE.md ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIEL=
STRIPE_PRICE_PRO=
# Calcul automatique de la TVA par Stripe Tax (1 = activé)
STRIPE_AUTOMATIC_TAX=
# Durée de l'essai gratuit en jours
TRIAL_DAYS=30

# ---------- E-mails (vide = e-mails affichés dans la console) — docs/EMAILS.md ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 1 pour une connexion TLS directe (port 465)
SMTP_SECURE=
# Expéditeur (adresse d'un domaine authentifié SPF/DKIM chez votre fournisseur)
MAIL_FROM="Pack Hygiène <alertes@mon-domaine.fr>"

# ---------- Photos ----------
# Quota de stockage par établissement, en Mo
PHOTO_QUOTA_MB=2000

# ---------- Informations légales (pages /legal/...) — docs/LEGAL.md ----------
LEGAL_COMPANY=
LEGAL_FORM=
LEGAL_CAPITAL=
LEGAL_ADDRESS=
LEGAL_SIREN=
LEGAL_RCS=
LEGAL_VAT=
LEGAL_EMAIL=
LEGAL_DPO_EMAIL=
LEGAL_PHONE=
LEGAL_DIRECTOR=
LEGAL_COURT=
HOST_NAME=
HOST_ADDRESS=
HOST_PHONE=
HOST_LOCATION=France
MAIL_PROVIDER=

# ---------- Sauvegardes chiffrées (restic) — docs/DEPLOIEMENT.md ----------
# Dépôt S3, ex. Scaleway Paris : s3:https://s3.fr-par.scw.cloud/mon-bucket-sauvegardes/haccp
RESTIC_REPOSITORY=
# Mot de passe de chiffrement : À CONSERVER HORS DU SERVEUR, sans lui les sauvegardes sont illisibles
RESTIC_PASSWORD=
# Clés d'accès au stockage objet
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Région du stockage objet (fr-par pour Scaleway Paris, gra pour OVHcloud Gravelines...)
AWS_DEFAULT_REGION=fr-par
# Fréquence (cron) : par défaut toutes les heures à la 15e minute
BACKUP_CRON=15 * * * *
# Adresse de surveillance (ex. healthchecks.io) prévenue après chaque sauvegarde, ou /fail en cas d'échec
BACKUP_PING_URL=
# Fréquence des instantanés de la base par l'application, en minutes
BACKUP_INTERVAL_MIN=60
