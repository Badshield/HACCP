# Port HTTP
PORT=3000
# Secret de signature des sessions : OBLIGATOIRE en production (chaîne longue et aléatoire)
JWT_SECRET=
# Emplacement de la base SQLite
DB_FILE=./data/haccp.db
# Fuseau horaire d'affichage dans les PDF
TZ_DISPLAY=Europe/Paris
# Mettre à 1 derrière un reverse proxy (Nginx, Caddy, Traefik...)
TRUST_PROXY=

# ---------- Facturation Stripe (laisser vide = facturation désactivée, accès illimité) ----------
# Clé secrète (sk_test_... pour les essais, sk_live_... en production)
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix mensuels créés dans Stripe (price_...)
STRIPE_PRICE_ESSENTIEL=
STRIPE_PRICE_PRO=
# Calcul automatique de la TVA par Stripe Tax (1 = activé)
STRIPE_AUTOMATIC_TAX=
# Durée de l'essai gratuit en jours
TRIAL_DAYS=30
# Adresse publique de l'application (redirections après paiement)
APP_URL=https://app.mon-domaine.fr

# ---------- E-mails (laisser SMTP_HOST vide = e-mails affichés dans la console) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 1 pour une connexion TLS directe (port 465)
SMTP_SECURE=
# Expéditeur affiché (adresse d'un domaine authentifié SPF/DKIM chez votre fournisseur)
MAIL_FROM="Pack Hygiène <alertes@mon-domaine.fr>"
# Nom affiché dans les e-mails
APP_NAME=Pack Hygiène HACCP

# ---------- Photos ----------
# Dossier de stockage (à sauvegarder avec la base de données)
UPLOAD_DIR=./data/uploads
# Quota de stockage par établissement, en Mo
PHOTO_QUOTA_MB=2000

# ---------- Informations légales (pages /legal/...) ----------
LEGAL_COMPANY=
LEGAL_FORM=
LEGAL_CAPITAL=
LEGAL_ADDRESS=
LEGAL_SIREN=
LEGAL_RCS=
LEGAL_VAT=
LEGAL_EMAIL=
LEGAL_DPO_EMAIL=
LEGAL_PHONE=
LEGAL_DIRECTOR=
LEGAL_COURT=
HOST_NAME=
HOST_ADDRESS=
HOST_PHONE=
HOST_LOCATION=France
MAIL_PROVIDER=

# ---------- Page d'accueil ----------
# Adresse qui reçoit les demandes de démo (par défaut LEGAL_EMAIL)
CONTACT_EMAIL=
