# Reverse proxy HTTPS : Caddy obtient et renouvelle automatiquement le
# certificat Let's Encrypt pour {$DOMAIN}.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Photos de 8 Mo maximum côté application : marge pour l'encodage.
	request_body {
		max_size 12MB
	}

	reverse_proxy app:3000

	# Pendant une mise à jour (quelques secondes), message clair au lieu d'une erreur brute.
	handle_errors 502 503 504 {
		header Retry-After 10
		respond "Mise à jour en cours : l'application revient dans quelques secondes." 503
	}

	log {
		output stdout
		format console
	}
}

# Redirige www.{$DOMAIN} vers le domaine principal (si l'enregistrement DNS existe).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
