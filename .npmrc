# Aucune dépendance n'a besoin de script d'installation : better-sqlite3 embarque
# déjà son module compilé pour Windows, Mac et Linux. Sans cette ligne, npm
# tenterait une compilation qui exige Python et des outils de développement,
# souvent absents sur un ordinateur de bureau. C'est aussi plus sûr : aucun
# script tiers ne s'exécute pendant l'installation.
ignore-scripts=true
